{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "WinWam Rust: Build",
      "type": "process",
      "command": "cargo",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "WinWam Rust: Build Release",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "WinWam Rust: Check",
      "type": "process",
      "command": "cargo",
      "args": ["check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": "test"
    }
  ]
}
