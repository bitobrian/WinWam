{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WinWam Rust: Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\target\\debug\\winwam.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "WinWam Rust: Build",
      "stopAtEntry": false
    },
    {
      "name": "WinWam Rust: Release",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\target\\release\\winwam.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "WinWam Rust: Build Release",
      "stopAtEntry": false
    }
  ]
}
